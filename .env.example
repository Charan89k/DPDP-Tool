# ============================================================================
# Truth Labs International (TLI) — DPDP Compliance Gap Analysis Tool
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to .env for local development: cp .env.example .env
# - NEVER commit real credentials, passwords, or production database URLs to Git.
# - Production deployments must supply secrets via secure secret managers (e.g., AWS Secrets Manager).
# ============================================================================

# ----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16+)
# ----------------------------------------------------------------------------
# Migration Administrator Connection (Used strictly by scripts/migrate.py)
# Requires DDL privileges (table creation, enum types, migrations tracking)
DATABASE_MIGRATION_URL="postgresql://dpdp_migration_admin:REPLACE_WITH_MIGRATION_PASSWORD@localhost:5432/dpdp_dev"

# Runtime Application Connection (Used by application server / connection pool)
# Role MUST have NOSUPERUSER and NOBYPASSRLS to enforce PostgreSQL Row-Level Security
DATABASE_URL="postgresql://dpdp_app_user:REPLACE_WITH_APP_PASSWORD@localhost:5432/dpdp_dev"

# ----------------------------------------------------------------------------
# 2. RUNTIME ROLE CREDENTIALS (Local Provisioning)
# ----------------------------------------------------------------------------
DB_MIGRATION_USER="dpdp_migration_admin"
DB_MIGRATION_PASSWORD="REPLACE_WITH_MIGRATION_PASSWORD"

DB_APP_USER="dpdp_app_user"
DB_APP_PASSWORD="REPLACE_WITH_APP_PASSWORD"

# ----------------------------------------------------------------------------
# 3. EVIDENCE OBJECT STORAGE VAULT (Phase 3B)
# Provider-neutral S3-compatible configuration (AWS S3, MinIO, Ceph, Cloudflare R2)
# ----------------------------------------------------------------------------
# Set STORAGE_ENDPOINT for local MinIO / emulators (e.g., http://127.0.0.1:9000).
# Leave empty for standard AWS S3 endpoints.
STORAGE_ENDPOINT=""
STORAGE_REGION="ap-south-1"
STORAGE_BUCKET="tli-dpdp-vault-dev"
STORAGE_USE_SSL="true"

# Storage credentials (use IAM roles / IRSA in production Kubernetes/AWS)
STORAGE_ACCESS_KEY_ID="REPLACE_WITH_STORAGE_ACCESS_KEY"
STORAGE_SECRET_ACCESS_KEY="REPLACE_WITH_STORAGE_SECRET_KEY"

# Presigned URL lifetimes (Strict boundaries: 10m upload, 15m download)
STORAGE_PRESIGNED_UPLOAD_EXPIRY_SECONDS="600"
STORAGE_PRESIGNED_DOWNLOAD_EXPIRY_SECONDS="900"

# Enforceable file constraints (Default: 50 MB)
STORAGE_MAX_FILE_SIZE_BYTES="52428800"

# Server-Side Encryption (SSE-KMS or SSE-S3; key management subject to DEC-03)
S3_KMS_KEY_ID="arn:aws:kms:ap-south-1:123456789012:key/REPLACE_WITH_KMS_KEY_ID"

# ----------------------------------------------------------------------------
# 4. MALWARE SCANNING INTEGRATION (Phase 3B)
# Options: 'LOCAL_MOCK' (testing), 'CLAMAV' (clamd daemon), 'AWS_GUARDDUTY' (EventBridge)
# ----------------------------------------------------------------------------
MALWARE_SCANNER_PROVIDER="LOCAL_MOCK"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_SECONDS="10.0"

# ----------------------------------------------------------------------------
# 5. APPLICATION SECURITY (Next.js & Auth - Phase 3C)
# ----------------------------------------------------------------------------
SESSION_SECRET="REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING"
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING"
NEXTAUTH_URL="http://localhost:3000"

