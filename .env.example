# =============================================================================
# CloudE5 — environment configuration template
#
# Copy to .env and replace every placeholder. Never commit real values.
# Generate secrets with:  openssl rand -base64 48
# =============================================================================

# Runtime mode. Use "production" on servers.
NODE_ENV=production

# Public URL users reach CloudE5 at (used in email links and CSRF origin checks).
CLOUDE5_PUBLIC_URL=https://cloude5.example.com

# Session signing secret: at least 32 random characters. Changing it signs everyone out.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# -----------------------------------------------------------------------------
# Storage (must live on persistent disk; the Docker image uses the /data volume)
# -----------------------------------------------------------------------------
CLOUDE5_DATABASE_PATH=/data/db/cloude5.db
CLOUDE5_EVIDENCE_DIR=/data/evidence

# -----------------------------------------------------------------------------
# Email (required for verification, password reset and invitations in production)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for implicit TLS (usually port 465); STARTTLS is used otherwise.
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="CloudE5 <no-reply@cloude5.example.com>"

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Honour CF-Connecting-IP for rate limiting only when Cloudflare fronts this server.
# TRUST_CLOUDFLARE_IP_HEADER=true

# First platform administrator password for `npm run admin:create` (min 14 chars).
# Leave unset to have a strong password generated into a 0600 credentials file.
# CLOUDE5_ADMIN_PASSWORD=

# Development only: where emails are written when SMTP is not configured.
# CLOUDE5_DEV_OUTBOX_DIR=./.cloude5/dev-outbox
