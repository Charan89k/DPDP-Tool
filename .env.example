# =============================================================================
# TLI — environment configuration template
#
# Copy to .env and replace every placeholder. Never commit real values.
# Generate secrets with:  openssl rand -base64 48
# =============================================================================

# Runtime mode. Use "production" on servers.
NODE_ENV=production

# Public URL users reach the TLI platform at (used in email links and CSRF origin checks).
CLOUDE5_PUBLIC_URL=https://cloude5.example.com

# Session signing secret: at least 32 random characters. Changing it signs everyone out.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Encrypts two-factor (TOTP) secrets. 32 random bytes, base64: `openssl rand -base64 32`.
# Optional (derived from SESSION_SECRET when empty) but recommended; never change it once users enrol.
CLOUDE5_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Storage (must live on persistent disk; the Docker image uses the /data volume)
# -----------------------------------------------------------------------------
CLOUDE5_DATABASE_PATH=/data/db/cloude5.db
CLOUDE5_EVIDENCE_DIR=/data/evidence

# -----------------------------------------------------------------------------
# Email (required for verification, password reset and invitations in production)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for implicit TLS (usually port 465); STARTTLS is required otherwise. Plaintext is only
# used for a local mail catcher (SMTP_HOST=mailpit or localhost) or with SMTP_ALLOW_PLAINTEXT=true.
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="Truth Labs International <no-reply@cloude5.example.com>"

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Client IPs for rate limiting come from the rightmost X-Forwarded-For entry added by your proxy.
# Honour CF-Connecting-IP only when Cloudflare fronts this server:
# TRUST_CLOUDFLARE_IP_HEADER=true
# Honour X-Real-IP only when your proxy overwrites it:
# CLOUDE5_TRUST_X_REAL_IP=true

# First platform administrator password for `npm run admin:create` (min 14 chars).
# Leave unset to have a strong password generated into a 0600 credentials file.
# CLOUDE5_ADMIN_PASSWORD=

# Development only: where emails are written when SMTP is not configured.
# CLOUDE5_DEV_OUTBOX_DIR=./.cloude5/dev-outbox

# -----------------------------------------------------------------------------
# Paid report delivery (Razorpay). Leave the keys empty to turn online payment off.
# Test Mode keys start with rzp_test_, Live Mode keys with rzp_live_. See docs/PAYMENTS.md.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET
# The secret entered on the Razorpay webhook (https://<domain>/api/payments/razorpay/webhook).
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
# Central TLI mailbox that receives a copy of every delivered report (not a personal address).
TLI_ASSESSOR_EMAIL=assessor@tli.example.com
# Optional contact address shown in the customer's report email.
# TLI_SUPPORT_EMAIL=support@example.com

# -----------------------------------------------------------------------------
# Optional virus scanning of evidence uploads (docker compose --profile antivirus).
# While set, uploads are refused if the scanner is unreachable.
# -----------------------------------------------------------------------------
CLOUDE5_CLAMAV_HOST=
CLOUDE5_CLAMAV_PORT=3310
