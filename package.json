{
  "name": "tli-dpdp-tool",
  "version": "1.0.0",
  "description": "TLI DPDP Compliance Gap Analysis Tool — Truth Labs International",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types scripts/prepare-test-db.ts && CLOUDE5_TEST_DATABASE_TEMPLATE=.test-db/template.db CLOUDE5_DEV_OUTBOX_DIR=.test-db/outbox CLOUDE5_EVIDENCE_DIR=.test-db/evidence node --experimental-strip-types --test tests/**/*.test.ts",
    "db:migrate": "node --experimental-strip-types scripts/cloude5-db.ts migrate",
    "db:status": "node --experimental-strip-types scripts/cloude5-db.ts status",
    "db:verify": "node --experimental-strip-types scripts/cloude5-db.ts verify",
    "db:backup": "node --experimental-strip-types scripts/cloude5-db.ts backup",
    "db:restore": "node --experimental-strip-types scripts/cloude5-db.ts restore",
    "db:seed-demo": "node --experimental-strip-types scripts/cloude5-db.ts seed-demo",
    "admin:create": "node --experimental-strip-types scripts/create-platform-admin.ts",
    "db:verify-email": "node --experimental-strip-types scripts/cloude5-db.ts verify-email",
    "db:import-postgres": "node --experimental-strip-types scripts/import-postgres.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "docx": "^9.10.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^16.4.2",
    "nodemailer": "^10.1.6",
    "pg": "^8.13.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "braces": "^3.0.3"
  }
